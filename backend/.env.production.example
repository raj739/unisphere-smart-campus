APP_NAME=UniSphere
ENVIRONMENT=production
DEBUG=false

POSTGRES_DB=unisphere_db
POSTGRES_USER=unisphere
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

DATABASE_URL=postgresql+psycopg://unisphere:CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/unisphere_db

JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_BASE_SECONDS=1

ALLOWED_ORIGINS=http://localhost:3000

BACKEND_PORT=8000
WEB_CONCURRENCY=2
WEB_TIMEOUT=120
